@if (IsVisible)
{
    <div class="modal-backdrop fade show" @onclick="OnCancel"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog" id="confirm-dialog-modal">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content custom-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirm-dialog-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body" id="confirm-dialog-message">
                    <p>@Message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline btn-sm" id="confirm-dialog-cancel-btn" @onclick="OnCancel">
                        @CancelText
                    </button>
                    <button type="button" class="btn btn-danger btn-sm ms-2" id="confirm-dialog-confirm-btn" @onclick="OnConfirm">
                        @ConfirmText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm Action";

    [Parameter]
    public string Message { get; set; } = "Are you sure you want to proceed?";

    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
