@page "/forbidden"

<PageTitle>OneAccess - Access Forbidden</PageTitle>

<div class="forbidden-container">
    <div class="forbidden-card card">
        <div class="card-body text-center p-5">
            <div class="forbidden-icon mb-3">
                <span class="badge-status-danger" style="font-size: 2.5rem; display: inline-block; padding: 12px 20px; border-radius: 50%;">🚫</span>
            </div>
            <h1 class="h2 text-danger mb-2">403 - Forbidden</h1>
            <p class="lead text-secondary mb-4">You do not have the required permissions to perform this action or access this resource.</p>
            <div class="actions">
                <a href="/" class="btn btn-primary" id="forbidden-home-btn">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
